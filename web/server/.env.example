# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/qa_tester_agent

# Python Subprocess Configuration
# Optional: explicitly specify Python path if not using root .venv
# PYTHON_PATH=x:\QA Testing Agent\.venv\Scripts\python.exe
MAX_CONCURRENT_JOBS=2
EXECUTION_TIMEOUT_MS=300000

# Security Configuration
# Set to 'true' in development to allow testing against localhost / 127.0.0.1 demo shop
ALLOW_LOCAL_TARGETS=true
